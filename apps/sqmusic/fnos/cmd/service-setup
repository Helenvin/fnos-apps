#!/bin/bash
# SQMusic Docker app — wizard integration (drop-in 接管既有部署)

service_postinst() {
    # 音乐/MySQL 目录按向导输入兜底创建；留空时使用 compose 内置默认值
    if [ -n "${wizard_music_dir:-}" ]; then
        mkdir -p "${wizard_music_dir}" 2>/dev/null || true
        install_log "SQMusic 音乐目录: ${wizard_music_dir}"
    fi
    if [ -n "${wizard_mysql_dir:-}" ]; then
        mkdir -p "${wizard_mysql_dir}" 2>/dev/null || true
        install_log "SQMusic MySQL 数据目录: ${wizard_mysql_dir}"
    fi
}
